<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!--
        The sales_order columns are deliberately not in etc/db_schema_whitelist.json: without a whitelist entry,
        Magento never drops them, so the partner data on orders survives module:disable + setup:upgrade (as in 2.3.x).
        Changes that drop nothing, such as widening a column, are applied without one. Setup/Uninstall.php removes the
        columns on module:uninstall -r. If the whitelist is regenerated (setup:db-declaration:generate-whitelist),
        remove the sales_order entries again.
    -->
    <table name="sales_order" resource="sales" comment="Sales Flat Order">
        <column xsi:type="varchar" name="partnerads_partner_id" nullable="true" length="100" comment="PartnerAds Partner Id"/>
        <column xsi:type="varchar" name="partnerads_pacid_id" nullable="true" length="255" comment="PartnerAds PacId Id"/>
        <column xsi:type="int" name="partnerads_order_sent" padding="5" unsigned="false" nullable="true" identity="false" comment="PartnerAds Order Sent"/>
    </table>
    <table name="partner_module_export" resource="sales" engine="innodb" comment="PartnerAds Export Retries And Failures">
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" identity="false" comment="Order Entity Id"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" comment="retry or failed"/>
        <column xsi:type="smallint" name="attempts" padding="5" unsigned="true" nullable="false" identity="false" default="0" comment="Attempts Made"/>
        <column xsi:type="datetime" name="last_attempt_at" on_update="false" nullable="true" comment="Last Attempt (UTC)"/>
        <column xsi:type="datetime" name="next_attempt_at" on_update="false" nullable="true" comment="Next Attempt (UTC)"/>
        <column xsi:type="varchar" name="last_error" nullable="true" length="255" comment="Last Error"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PARTNER_MODULE_EXPORT_ORDER_ID_SALES_ORDER_ENTITY_ID" table="partner_module_export" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="PARTNER_MODULE_EXPORT_STATUS_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
    </table>
</schema>
