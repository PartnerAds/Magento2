<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The cookie endpoint (papartner/ajax/cookie) is never cacheable, also when another module makes the response
         public after its controller ran. A high sortOrder runs these before-plugins after other modules' ones. -->
    <type name="Magento\Framework\App\Response\Http">
        <plugin name="partner_cookie_endpoint_no_cache" type="Partner\Module\Model\Plugin\CookieEndpoint\ResponseNoCache" sortOrder="10000"/>
    </type>
    <type name="Magento\Framework\App\PageCache\Kernel">
        <plugin name="partner_cookie_endpoint_no_cache" type="Partner\Module\Model\Plugin\CookieEndpoint\PageCacheKernelNoCache" sortOrder="10000"/>
    </type>
</config>
